# ─── Database ───
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_pass@db:5432/sentinelexam
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_pass
POSTGRES_DB=sentinelexam

# ─── Auth ───
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Snapshots ───
SNAPSHOT_DIR=/app/storage/snapshots
SNAPSHOT_RETENTION_DAYS=30

# ─── Scoring Weights (must sum to 1.0) ───
WEIGHT_KEYSTROKE=0.35
WEIGHT_FACE=0.40
WEIGHT_GAZE=0.25

# ─── Risk Thresholds ───
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.8

# ─── Telemetry ───
SNAPSHOT_INTERVAL_SECONDS=45
TELEMETRY_WINDOW_SECONDS=30
